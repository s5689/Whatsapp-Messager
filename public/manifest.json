{
  "manifest_version": 3,
  "name": "Whatsapp Messager",
  "version": "7.0.0.0",
  "description": "Que pereza escribir todo a mano zzz...",
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background/main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/main.js"]
    }
  ],
  "permissions": ["activeTab", "tabs", "scripting", "contextMenus"],
  "host_permissions": ["https://www.nombrerutyfirma.com/*", "https://reservo.cl/*"],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
