{
  "manifest_version": 3,
  "name": "Whatsapp Messager",
  "version": "6.0.0.0",
  "description": "Que pereza escribir todo a mano zzz...",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["jquery.js", "jquery-ui.js", "content.js"],
      "css": ["jquery-ui.css"]
    }
  ],
  "permissions": ["activeTab", "tabs", "scripting", "contextMenus"],
  "host_permissions": [
    "https://www.nombrerutyfirma.com/*",
    "https://reservo.cl/appointment/makeAppointment/*"
  ],
  "icons": {
    "48": "/icon48.png",
    "128": "/icon128.png"
  }
}
